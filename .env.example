# =====================================================================
#  Sports Lakehouse - cấu hình môi trường
#  Copy file này thành .env:   Copy-Item .env.example .env   (PowerShell)
#  Sau đó chỉ cần sửa các dòng có ghi chú "SỬA".
# =====================================================================

# ---------- Chế độ thu thập ----------
# mock   : gọi Mock API-Football chạy trong Docker (mặc định, không tốn hạn mức)
# live   : gọi API-Football thật (cần APIFOOTBALL_KEY)
# replay : phát lại các phản hồi API đã ghi trong data/raw/apifootball
# off    : tắt collector (dùng khi chỉ chạy replay StatsBomb/Metrica)
COLLECTOR_MODE=mock

# ---------- API-Football (chế độ live) ----------
# SỬA: dán key lấy ở https://dashboard.api-football.com (gói Free)
APIFOOTBALL_KEY=
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Danh sách giải theo dõi (id API-Football): 39=Ngoại hạng Anh, 140=La Liga, 2=UEFA Champions League
LEAGUE_IDS=39,140,2
# Ngân sách request/ngày và /phút (gói Free: 100/ngày, 10/phút)
DAILY_REQUEST_BUDGET=100
MINUTE_REQUEST_LIMIT=10
# Số request giữ lại dự phòng, không cho bộ lập lịch dùng
BUDGET_RESERVE=5
# adaptive (thích ứng) hoặc fixed (cố định, dùng để so sánh trong E5)
SCHEDULER_POLICY=adaptive
FIXED_INTERVAL_SECONDS=90
# Ghi lại phản hồi thô để Replay về sau
RECORD_RAW=true

# ---------- Mock API ----------
# Tốc độ đồng hồ trận giả lập: 1 = thời gian thật (90 phút), 10 = một trận ~10 phút
MOCK_SPEED=10
# Số trận giả lập và khoảng cách giờ bắt đầu giữa các trận (phút thật)
MOCK_MATCHES=3
MOCK_KICKOFF_GAP_MIN=2
MOCK_SEED=42
# Xác suất một trận có tình huống VAR hủy bàn thắng (0..1)
MOCK_VAR_PROB=0.7
# Nguồn kịch bản: synthetic (tự sinh) hoặc statsbomb (lấy diễn biến thật từ data/statsbomb)
MOCK_SCENARIO_SOURCE=synthetic
# Hạn mức giả lập giống gói Free
MOCK_DAILY_LIMIT=100
MOCK_MINUTE_LIMIT=10

# ---------- Kafka / Schema Registry ----------
KAFKA_BOOTSTRAP=kafka1:19092,kafka2:19092,kafka3:19092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ---------- MinIO (S3) - nơi chứa bảng Delta ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
LAKEHOUSE_BUCKET=lakehouse

# ---------- Spark ----------
SPARK_MASTER=spark://spark-master:7077
# Số core tối đa pipeline streaming được dùng (để chừa core cho job gold)
PIPELINE_CORES_MAX=2
PIPELINE_EXECUTOR_MEMORY=768m
PIPELINE_DRIVER_MEMORY=1g
# Chu kỳ vi lô (giây)
TRIGGER_EVENTS_SECONDS=2
TRIGGER_TRACKING_SECONDS=5
# Bật/tắt luồng dữ liệu vị trí (Metrica) và đồng bộ Elasticsearch
ENABLE_TRACKING_STREAM=true
ENABLE_ES_SYNC=true
# Ngưỡng watermark loại trùng (phút)
DEDUP_WATERMARK_MINUTES=10
# Bảo trì bảng silver chạy trong driver pipeline (phút, 0 = tắt)
MAINTENANCE_INTERVAL_MIN=30
VACUUM_RETENTION_HOURS=168

# ---------- Job gold ----------
GOLD_INTERVAL_MIN=10
GOLD_MODE=incremental

# ---------- Chỉ số kịch tính ----------
# V1 = luật, V2 = chấm điểm (mặc định bật cả hai)
EXCITEMENT_VERSIONS=V1,V2
EXCITEMENT_THRESHOLD=7.0

# ---------- Elasticsearch ----------
ES_URL=http://elasticsearch:9200

# ---------- Cảnh báo ----------
# SỬA (tùy chọn): token bot Telegram và chat id; để trống thì chỉ ghi log + Elasticsearch
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SỬA (tùy chọn): URL webhook nhận cảnh báo (vd. Discord/Slack incoming webhook)
ALERT_WEBHOOK_URL=

# ---------- Tài nguyên cụm (máy 16 GB: cấp cho Docker/WSL khoảng 10-12 GB) ----------
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g
JOB_EXECUTOR_MEMORY=768m
JOB_DRIVER_MEMORY=768m
LOG_LEVEL=INFO
